# Copy to .env.local (gitignored). Read-only access is enough.
# Fine-grained PAT, repositories: the ones listed in projects/.
# Permissions: Issues (read), Pull requests (read), Contents (read), Commit statuses (read).
BOARD_GITHUB_TOKEN=

# Optional separate fine-grained PAT for creating issues.
# Permissions: Issues (read/write) only, limited to repositories registered in the board.
# Issues are authored by the GitHub account that owns this token.
ISSUE_GITHUB_TOKEN=
