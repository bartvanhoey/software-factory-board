# Copy to .env (gitignored) and fill in. Never commit real values.

# Claude Code authentication.
CLAUDE_CODE_OAUTH_TOKEN=

# Shared secret between the runner and the web service: the runner presents it to fetch the projects (managed in the
# web app). Required by both. Generate 32 random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RUNNER_API_TOKEN=

# Scheduler: runs the lanes (review, qa, build) automatically for every project that is switched on in the web app.
# Off by default. Once on, it builds issues labelled "ready" with your tokens, so turn it on on purpose.
# It never merges a pull request.
SCHEDULER_ENABLED=false
# Minutes to wait after a pass ends before the next one starts (1 to 1440).
SCHEDULER_INTERVAL_MINUTES=5
# A single run is stopped after this many minutes (1 to 170).
SCHEDULER_RUN_TIMEOUT_MINUTES=120

# Dashboard (read-only token: Issues, Pull requests, Contents, Commit statuses = read).
# Empty = the dashboard shows demo data. Never reuse RUNNER_GITHUB_TOKEN here.
BOARD_GITHUB_TOKEN=
RUNNER_GITHUB_TOKEN=

# Dashboard login (web only). Required: the web container refuses to start without it.
# Generate 32 random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes every stored MFA secret unreadable; keep a copy outside the repo.
MFA_ENCRYPTION_KEY=

# First admin, created on first start only when no admin exists yet. Set both or neither.
# Password: 12-128 characters. Remove ADMIN_PASSWORD from .env after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email verification and "forgot password" by email. Off by default. When true, every SMTP_* value and APP_URL are
# required. Port 465 uses TLS from the start; any other port must offer STARTTLS (there is no plaintext option).
EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# The public address of this site, for the links in emails: just the address, no path (https://board.example.com).
# https is required except for localhost. Links are built from this and never from the incoming request.
APP_URL=

# Session cookie Secure flag. Empty = on in production. Plain http on localhost needs false;
# exposing the dashboard beyond localhost needs a TLS proxy in front.
COOKIE_SECURE=false

# Believe X-Forwarded-For from a reverse proxy in front of the dashboard. Leave false without one:
# the header is spoofable, and without it logins are throttled per account only.
TRUST_PROXY=false
