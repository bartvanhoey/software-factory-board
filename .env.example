# Copy to .env (gitignored) and fill in. Never commit real values.

# Fine-grained PAT of the bot account, scoped to the listed repos only:
# Contents, Issues, Pull requests: read and write.
GH_TOKEN=

# Claude Code authentication.
ANTHROPIC_API_KEY=

# Dashboard (read-only token: Issues, Pull requests, Contents, Commit statuses = read).
# Empty = the dashboard shows demo data. Never reuse GH_TOKEN here.
WEB_GH_TOKEN=
